{
  "buildCommand": "npm run build",
  "installCommand": "npm install && npm rebuild sqlite3",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
